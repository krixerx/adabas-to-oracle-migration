<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>50_vehicle</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>VEHICLES file -> POCAPP.VEHICLE, joined to EMPLOYEE via PERSONNEL_ID lookup</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/04 18:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/04 18:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read vehicles.csv</from>
      <to>resolve emp_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>resolve emp_id</from>
      <to>VEHICLE</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read vehicles.csv</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${DATA_DIR}/vehicles.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <schemaDefinition/>
    <fields>
      <field>
        <name>isn</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>reg_num</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>personnel_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>make</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>model</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>color</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>year_built</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>resolve emp_id</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>5000</cache_size>
    <lookup>
      <schema>POCAPP</schema>
      <table>EMPLOYEE</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>personnel_id</name>
        <field>PERSONNEL_ID</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>EMP_ID</name>
        <rename>emp_id</rename>
        <default/>
        <type>BigNumber</type>
        <trim_type>none</trim_type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>VEHICLE</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <schema>POCAPP</schema>
    <table>VEHICLE</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>SOURCE_ISN</column_name>
        <stream_name>isn</stream_name>
      </field>
      <field>
        <column_name>EMP_ID</column_name>
        <stream_name>emp_id</stream_name>
      </field>
      <field>
        <column_name>REG_NUM</column_name>
        <stream_name>reg_num</stream_name>
      </field>
      <field>
        <column_name>MAKE</column_name>
        <stream_name>make</stream_name>
      </field>
      <field>
        <column_name>MODEL</column_name>
        <stream_name>model</stream_name>
      </field>
      <field>
        <column_name>COLOR</column_name>
        <stream_name>color</stream_name>
      </field>
      <field>
        <column_name>YEAR_BUILT</column_name>
        <stream_name>year_built</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <attributes/>
</pipeline>
