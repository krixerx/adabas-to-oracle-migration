<?xml version="1.0" encoding="UTF-8"?>
<!--
  VEHICLES file -> POCAPP.VEHICLE_PLATE : one row per registration plate.

  THIS is where the duplicate rows pipeline 10 set aside are used. The same
  grouping as pipeline 10 (base VIN = first 17 characters, sorted so the
  un-suffixed row comes first), but here EVERY row of the group is kept and
  numbered 1..n - that number is the plate sequence. So the second and third
  Adabas rows for one VIN become the second and third plates of the ONE vehicle
  pipeline 10 created, found by looking the parent up on the base VIN.

  The new model allows at most three. A group with more is a source shape the
  target cannot represent, so the surplus rows go to MIGRATION_REJECT instead of
  being dropped: reconcile.ps1 asserts loaded + rejected = rows in the file, and
  that identity only holds if nothing disappears silently.

  Runs after 10 because it looks the parent up by VIN.
-->
<pipeline>
  <info>
    <name>20_vehicle_plate</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>VEHICLES -> POCAPP.VEHICLE_PLATE: one row per plate, surplus plates quarantined in MIGRATION_REJECT</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/17 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/17 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read vehicles.csv</from>
      <to>cut base VIN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>cut base VIN</from>
      <to>sort by VIN</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sort by VIN</from>
      <to>number the plates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>number the plates</from>
      <to>at most 3 plates</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>at most 3 plates</from>
      <to>resolve vehicle_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>at most 3 plates</from>
      <to>reject reason</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>resolve vehicle_id</from>
      <to>VEHICLE_PLATE</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>reject reason</from>
      <to>describe lost plate</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>describe lost plate</from>
      <to>MIGRATION_REJECT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read vehicles.csv</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${DATA_DIR}/vehicles.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <schemaDefinition/>
    <fields>
      <field>
        <name>isn</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>plate_no</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>personnel_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>make</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>model</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>color</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>year_built</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>vin</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>veh_type</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>fuel_desc</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>cut base VIN</name>
    <type>StringCut</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>vin</in_stream_name>
        <out_stream_name>vin_base</out_stream_name>
        <cut_from>0</cut_from>
        <cut_to>17</cut_to>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>272</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sort by VIN</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>platesort</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>vin_base</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>vin</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>number the plates</name>
    <type>FieldsChangeSequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>vin_base</name>
      </field>
    </fields>
    <increment>1</increment>
    <resultfieldName>plate_seq</resultfieldName>
    <start>1</start>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>at most 3 plates</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>resolve vehicle_id</send_true_to>
    <send_false_to>reject reason</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>plate_seq</leftvalue>
        <function>&lt;=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>3</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>752</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>resolve vehicle_id</name>
    <type>DBLookup</type>
    <description>Parent is matched on the BASE VIN - the suffixed rows have no key of their own.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>5000</cache_size>
    <lookup>
      <schema>POCAPP</schema>
      <table>VEHICLE</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>vin_base</name>
        <field>VIN</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>VEHICLE_ID</name>
        <rename>vehicle_id</rename>
        <default/>
        <type>BigNumber</type>
        <trim_type>none</trim_type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>912</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>reject reason</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <format/>
        <group/>
        <length>-1</length>
        <name>source_file</name>
        <nullif>vehicles.csv</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
      </field>
      <field>
        <currency/>
        <decimal/>
        <format/>
        <group/>
        <length>-1</length>
        <name>reason</name>
        <nullif>more than 3 plates registered on one VIN</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>912</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>VEHICLE_PLATE</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <schema>POCAPP</schema>
    <table>VEHICLE_PLATE</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>VEHICLE_ID</column_name>
        <stream_name>vehicle_id</stream_name>
      </field>
      <field>
        <column_name>PLATE_SEQ</column_name>
        <stream_name>plate_seq</stream_name>
      </field>
      <field>
        <column_name>PLATE_NO</column_name>
        <stream_name>plate_no</stream_name>
      </field>
      <field>
        <column_name>SOURCE_ISN</column_name>
        <stream_name>isn</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1072</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>describe lost plate</name>
    <type>ScriptValueMod</type>
    <description>A reject row has to name the PLATE that was lost, not just the VIN.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>describe_lost_plate</jsScript_name>
        <jsScript_script>
// The VIN alone does not tell anyone what was actually lost here: a REGISTRATION
// went missing. Name the plate, the VIN it belonged to, and which position it
// would have taken - that is enough for someone to decide what to do about it
// without going back to Adabas.
var detail = "plate " + String(plate_no)
           + " (VIN " + String(vin)
           + ", would have been plate " + String(plate_seq) + ")";
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>detail</name>
        <rename>detail</rename>
        <type>String</type>
        <length>200</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1072</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>MIGRATION_REJECT</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <schema>POCAPP</schema>
    <table>MIGRATION_REJECT</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>SOURCE_FILE</column_name>
        <stream_name>source_file</stream_name>
      </field>
      <field>
        <column_name>SOURCE_ISN</column_name>
        <stream_name>isn</stream_name>
      </field>
      <field>
        <column_name>REASON</column_name>
        <stream_name>reason</stream_name>
      </field>
      <field>
        <column_name>DETAIL</column_name>
        <stream_name>detail</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1232</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <attributes/>
</pipeline>
