<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>10_employee</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>EMPLOYEES file -> POCAPP.EMPLOYEE: YYYYMMDD to DATE, marital-status code resolved via CODE_LOOKUP</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/04 18:00:00.000</created_date>
    <modified_date>2026/08/04 18:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>read employees.csv</name>
    <filename>${DATA_DIR}/employees.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>isn</name>
        <length>-1</length>
        <type>Integer</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>personnel_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>first_name</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>middle_name</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>last_name</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>mar_stat</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>sex</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>birth_yyyymmdd</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>city</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>postal_code</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>country</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>dept</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>job_title</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>112</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>add lookup domain</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>MARITAL_STATUS</nullif>
        <name>lookup_domain</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>304</xloc>
      <yloc>112</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>resolve marital status</name>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_size>500</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>POCAPP</schema>
      <table>CODE_LOOKUP</table>
      <key>
        <name>lookup_domain</name>
        <name2/>
        <condition>=</condition>
        <field>DOMAIN</field>
      </key>
      <key>
        <name>mar_stat</name>
        <name2/>
        <condition>=</condition>
        <field>CODE</field>
      </key>
      <value>
        <name>DESCRIPTION</name>
        <rename>marital_status</rename>
        <default>Unknown</default>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>496</xloc>
      <yloc>112</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>convert birth date</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>birth_yyyymmdd</name>
        <rename>birth_date</rename>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask>yyyyMMdd</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>112</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>EMPLOYEE</name>
    <connection>ORACLE_POC</connection>
    <schema>POCAPP</schema>
    <table>EMPLOYEE</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>isn</stream_name>
        <column_name>SOURCE_ISN</column_name>
      </field>
      <field>
        <stream_name>personnel_id</stream_name>
        <column_name>PERSONNEL_ID</column_name>
      </field>
      <field>
        <stream_name>first_name</stream_name>
        <column_name>FIRST_NAME</column_name>
      </field>
      <field>
        <stream_name>middle_name</stream_name>
        <column_name>MIDDLE_NAME</column_name>
      </field>
      <field>
        <stream_name>last_name</stream_name>
        <column_name>LAST_NAME</column_name>
      </field>
      <field>
        <stream_name>birth_date</stream_name>
        <column_name>BIRTH_DATE</column_name>
      </field>
      <field>
        <stream_name>sex</stream_name>
        <column_name>GENDER_CODE</column_name>
      </field>
      <field>
        <stream_name>marital_status</stream_name>
        <column_name>MARITAL_STATUS</column_name>
      </field>
      <field>
        <stream_name>dept</stream_name>
        <column_name>DEPT_CODE</column_name>
      </field>
      <field>
        <stream_name>job_title</stream_name>
        <column_name>JOB_TITLE</column_name>
      </field>
      <field>
        <stream_name>city</stream_name>
        <column_name>CITY</column_name>
      </field>
      <field>
        <stream_name>postal_code</stream_name>
        <column_name>POSTAL_CODE</column_name>
      </field>
      <field>
        <stream_name>country</stream_name>
        <column_name>COUNTRY_CODE</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>880</xloc>
      <yloc>112</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>read employees.csv</from>
      <to>add lookup domain</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>add lookup domain</from>
      <to>resolve marital status</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>resolve marital status</from>
      <to>convert birth date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>convert birth date</from>
      <to>EMPLOYEE</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
