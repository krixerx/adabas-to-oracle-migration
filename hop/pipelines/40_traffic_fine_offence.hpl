<?xml version="1.0" encoding="UTF-8"?>
<!--
  MU OFFENCE-CODE -> POCAPP.TRAFFIC_FINE_OFFENCE.

  The multiple-value field of a fine: several offences seen in one stop. The
  extract already flattened it to parent_key (= the fine's Adabas ISN) plus
  occurrence_index; this pipeline turns the parent key into the surrogate
  fine_id and resolves the offence code to its description.

  Runs after 30.
-->
<pipeline>
  <info>
    <name>40_traffic_fine_offence</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>MU OFFENCE-CODE -> POCAPP.TRAFFIC_FINE_OFFENCE</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/17 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/17 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>read traffic_fine_offences.csv</from>
      <to>resolve fine_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>resolve fine_id</from>
      <to>add lookup domain</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>add lookup domain</from>
      <to>resolve offence</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>resolve offence</from>
      <to>TRAFFIC_FINE_OFFENCE</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>read traffic_fine_offences.csv</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${DATA_DIR}/traffic_fine_offences.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <schemaDefinition/>
    <fields>
      <field>
        <name>parent_key</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>occurrence_index</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>offence_code</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>resolve fine_id</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>5000</cache_size>
    <lookup>
      <schema>POCAPP</schema>
      <table>TRAFFIC_FINE</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>parent_key</name>
        <field>SOURCE_ISN</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>FINE_ID</name>
        <rename>fine_id</rename>
        <default/>
        <type>BigNumber</type>
        <trim_type>none</trim_type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>add lookup domain</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <format/>
        <group/>
        <length>-1</length>
        <name>lookup_domain</name>
        <nullif>OFFENCE</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>resolve offence</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>500</cache_size>
    <lookup>
      <schema>POCAPP</schema>
      <table>CODE_LOOKUP</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>lookup_domain</name>
        <field>DOMAIN</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>offence_code</name>
        <field>CODE</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>DESCRIPTION</name>
        <rename>offence_desc</rename>
        <default>Unknown</default>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>TRAFFIC_FINE_OFFENCE</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ORACLE_POC</connection>
    <schema>POCAPP</schema>
    <table>TRAFFIC_FINE_OFFENCE</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>FINE_ID</column_name>
        <stream_name>fine_id</stream_name>
      </field>
      <field>
        <column_name>SEQ_NO</column_name>
        <stream_name>occurrence_index</stream_name>
      </field>
      <field>
        <column_name>OFFENCE_CODE</column_name>
        <stream_name>offence_code</stream_name>
      </field>
      <field>
        <column_name>OFFENCE_DESC</column_name>
        <stream_name>offence_desc</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <attributes/>
</pipeline>
